# Flask session key: replace this with a long random value for your own local setup.
SECRET_KEY=replace-this-with-a-long-random-secret

# MySQL connection settings
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=campusconnect

# Local development only. Set to 1 only when serving over HTTPS.
COOKIE_SECURE=0
